# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` (it is gitignored). Do not reuse real
# credentials in this file.
#
# Which variables are required:
#   LOCAL DEVELOPMENT  -> none strictly; the app runs out-of-the-box with
#                         sensible dev defaults (SQLite, console email, DEBUG).
#   RENDER             -> SECRET_KEY, DEBUG=False, ALLOWED_HOSTS,
#                         CSRF_TRUSTED_ORIGINS, DATABASE_URL, and the EMAIL_*
#                         variables if real password-reset email is wanted.
#   VERCEL             -> same list; set them in Project Settings -> Environment
#                         Variables (or `.env.local` for the CLI). Vercel injects
#                         its own system variables (VERCEL, VERCEL_ENV,
#                         VERCEL_URL, VERCEL_BRANCH_URL,
#                         VERCEL_PROJECT_PRODUCTION_URL) — the app uses those to
#                         auto-allow its deployment domains, and DEBUG defaults
#                         to False whenever VERCEL=1/VERCEL_ENV is present.

# --- Django core --------------------------------------------------------
# Production: strong random value, e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(64))"`. Local: anything.
SECRET_KEY=change-me

# Production must be False. Accepts values: true/false/1/0/yes/no/on/off.
DEBUG=True

# Comma-separated. Production: your Render service domain e.g.
# app-name.onrender.com,yourcustomdomain.com
# On Vercel the *.vercel.app deployment hostnames are merged in automatically
# from Vercel's system environment variables — list only custom domains here.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated fully-qualified origins the app must accept CSRF posts from.
# Production example: https://app-name.onrender.com,https://www.example.com
# Vercel deployment origins (https://*.vercel.app) are added automatically.
CSRF_TRUSTED_ORIGINS=

# --- Database ------------------------------------------------------------
# Local: leave blank to use the default SQLite file (db.sqlite3).
# Production: full connection URL, e.g.
#   postgresql://user:password@host:5432/taskmanager
# Render supplies this automatically when a PostgreSQL database is attached.
DATABASE_URL=

# --- Security overrides (optional) ---------------------------------------
# Defaults flip to secure automatically when DEBUG=False. Override only if
# you know why (e.g. a local production-like smoke test over plain HTTP).
# SECURE_SSL_REDIRECT=
# SESSION_COOKIE_SECURE=
# CSRF_COOKIE_SECURE=
# SECURE_HSTS_SECONDS=31536000    # 0 disables HSTS

# --- Email (SMTP) --------------------------------------------------------
# Leave the EMAIL_* variables blank/empty for local development: Django will
# use the console email backend and print every outgoing message — including
# password-reset verification codes — to the terminal.
#
# Production: set EMAIL_BACKEND to the SMTP backend and provide real
# credentials. Without this, password-reset codes cannot be delivered. For
# Gmail use an App Password, never your regular Google account password.
# See README → "Email configuration".
EMAIL_BACKEND=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Task Manager <noreply@example.com>